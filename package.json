{
  "name": "geneva",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node select-app.js",
    "dev:geneva": "./switch-app.sh geneva dev",
    "dev:purr": "./switch-app.sh purr dev",
    "dev:paddock": "./switch-app.sh chained-horse dev",
    "dev:aquarium": "./switch-app.sh aquarium dev",
    "dev:elite": "./switch-app.sh elite dev",
    "dev:kittyFamily": "./switch-app.sh kittyFamily dev",
    "dev:kittyNews": "./switch-app.sh kittyNews dev",
    "build": "/bin/sh ./switch-app.sh geneva build",
    "build:geneva": "/bin/sh ./switch-app.sh geneva build",
    "build:purr": "/bin/sh ./switch-app.sh purr build",
    "build:paddock": "/bin/sh ./switch-app.sh chained-horse build",
    "build:aquarium": "/bin/sh ./switch-app.sh aquarium build",
    "build:elite": "/bin/sh ./switch-app.sh elite build",
    "build:kittyNews": "/bin/sh ./switch-app.sh kittyNews build",
    "build:all": "yarn build:geneva && yarn build:purr && yarn build:paddock && yarn build:aquarium && yarn build:elite && yarn build:kittyNews",
    "start": "yarn build:all && (yarn serve:purr &) && (yarn serve:paddock &) && (yarn serve:aquarium &) && (yarn serve:elite &) && (yarn serve:kittyNews &) && NODE_NO_WARNINGS=1 babel-node -r @babel/register --extensions '.ts' src/server/index.ts",
    "preview": "yarn vite preview",
    "preview:geneva": "VITE_APP=geneva yarn vite preview --outDir dist/geneva",
    "preview:purr": "VITE_APP=purr yarn vite preview --outDir dist/purr",
    "preview:paddock": "VITE_APP=chained-horse yarn vite preview --outDir dist/paddock",
    "preview:aquarium": "VITE_APP=aquarium yarn vite preview --outDir dist/aquarium",
    "preview:elite": "VITE_APP=elite yarn vite preview --outDir dist/elite",
    "serve:purr": "serve -s dist/purr -l 7001",
    "serve:paddock": "serve -s dist/paddock -l 7002",
    "serve:aquarium": "serve -s dist/aquarium -l 7003",
    "serve:elite": "serve -s dist/elite -l 7005",
    "serve:kittyNews": "serve -s dist/kittyNews -l 8001",
    "lint": "yarn eslint .",
    "test:browser": "yarn vitest --workspace=vitest.workspace.ts",
    "test:node": "yarn vitest --workspace=vitest.workspace.node.ts",
    "test:coverage": "yarn vitest --coverage",
    "test:node:coverage": "yarn vitest --workspace=vitest.workspace.node.ts --coverage --run --coverage.include='src/server/**/*.ts' --coverage.exclude='**/*.test.ts'",
    "ck:import": "./scripts/import-cryptokitties-data.sh",
    "ck:rebuild": "NODE_NO_WARNINGS=1 babel-node -r @babel/register --extensions '.ts' src/server/scripts/rebuild-cryptokitties.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google/model-viewer": "^4.3.1",
    "@octokit/graphql": "^8.2.0",
    "@octokit/graphql-schema": "^15.25.0",
    "@octokit/rest": "^21.1.0",
    "@openzeppelin/contracts": "^5.1.0",
    "axios": "^1.7.7",
    "big.js": "^7.0.1",
    "bn.js": "^5.2.1",
    "d3": "^7.9.0",
    "express": "^4.21.2",
    "js-base64": "^3.7.7",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.5.2",
    "moment": "^2.30.1",
    "mongoose": "^8.10.0",
    "ollama": "^0.5.12",
    "pretty-ms": "^9.3.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.1.0",
    "react-router-dom": "^6.26.2",
    "react-share": "^5.3.0",
    "react-slick": "^0.31.0",
    "react-slider": "^2.0.6",
    "serve": "^14.2.4",
    "slick-carousel": "^1.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.13",
    "three": "^0.184.0",
    "video.js": "^8.24.0",
    "web3": "^4.13.0",
    "web3-utils": "^4.3.3",
    "web3-validator": "^2.0.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.26.0",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/register": "^7.25.9",
    "@eslint/js": "^9.9.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bn.js": "^5.1.6",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-katex": "^3.0.4",
    "@types/react-slick": "^0.23.13",
    "@types/react-slider": "^1.3.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.48.2",
    "postcss": "^8.5.15",
    "tailwindcss": "3",
    "terser": "^5.39.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^3.0.5",
    "vitest-browser-react": "^0.0.3"
  }
}
